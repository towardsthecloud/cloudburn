{
  "name": "cloudburn-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "test": "pnpm docs:test && turbo run test",
    "docs:test": "node --test test/docs-check.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "clean": "turbo run clean",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm verify && turbo run build --force && changeset publish",
    "depupdate": "corepack up && pnpm update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "husky": "^9.1.7",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}
