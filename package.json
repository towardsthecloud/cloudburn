{
  "name": "cloudburn-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "test": "pnpm docs:test && pnpm release:test && turbo run test test:e2e test:package",
    "test:e2e": "turbo run test:e2e",
    "test:packages": "turbo run test:package",
    "docs:test": "node --test test/docs-check.test.mjs",
    "release:test": "node --test test/release-*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "clean": "turbo run clean",
    "verify:repo": "pnpm docs:check && pnpm docs:test && pnpm release:test && pnpm exec turbo boundaries",
    "verify:packages": "turbo run lint typecheck test test:e2e test:package",
    "verify": "pnpm verify:repo && pnpm verify:packages",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm verify && turbo run build --force && changeset publish",
    "depupdate": "corepack up && pnpm update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "turbo": "^2.11.6",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
