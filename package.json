{
  "name": "cloudburn-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "test": "pnpm docs:test && pnpm release:test && turbo run test test:e2e test:package",
    "test:e2e": "turbo run test:e2e",
    "test:packages": "turbo run test:package",
    "docs:test": "node --test test/docs-check.test.mjs test/owning-pages.test.mjs",
    "release:test": "node --test test/release-*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "clean": "turbo run clean",
    "verify:repo": "pnpm docs:check && pnpm docs:test && pnpm release:test && pnpm exec turbo boundaries",
    "verify:packages": "turbo run lint typecheck test test:e2e test:package",
    "verify": "pnpm verify:repo && pnpm verify:packages",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm verify && turbo run build --force && changeset publish",
    "depupdate": "corepack up && pnpm update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
