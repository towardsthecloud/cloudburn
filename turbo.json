{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "biome.jsonc", "pnpm-lock.yaml", "package.json"],
  "boundaries": {
    "tags": {
      "layer:rules": {
        "dependencies": {
          "deny": ["layer:sdk", "layer:cli"]
        }
      },
      "layer:sdk": {
        "dependencies": {
          "deny": ["layer:cli"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["test:inputs"]
    },
    "test:inputs": {
      "dependsOn": ["^test:inputs"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "test:package": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS"
      ]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
