{
  "name": "cloudburn-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "test": "pnpm docs:test && pnpm release:test && turbo run test test:e2e test:package",
    "test:e2e": "turbo run test:e2e",
    "test:packages": "turbo run test:package",
    "docs:test": "node --test test/docs-check.test.mjs test/owning-pages.test.mjs",
    "release:test": "node --test test/release-*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "clean": "turbo run clean",
    "verify:repo": "pnpm docs:check && pnpm docs:test && pnpm release:test && pnpm exec turbo boundaries",
    "verify:packages": "turbo run lint typecheck test test:e2e test:package",
    "verify": "pnpm verify:repo && pnpm verify:packages",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm verify && turbo run build --force && changeset publish",
    "depupdate": "corepack up && pnpm update --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3"
}
